# Build and packaging artifacts
build/
dist/
*.egg-info/
*.so
*.o
*.a

# Track pre-compiled binary extension and wheel distributions
!deltanet_v2/_C*.so
!wheels/
!wheels/*.whl

# Bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.cache/

# Standalone root cutlass scratch directory
/cutlass/

# Local prompts, scratch baselines, and Nsight Compute profiles (do not publish)
Prompt/
prompt/
*.ncu-rep
benchmark/*.png
.ipynb_checkpoints/
.vscode/
.idea/
