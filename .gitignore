# Build and packaging artifacts
build/
dist/
*.egg-info/
*.so
*.o
*.a

# Track pre-compiled binary extension and wheel distributions
!deltanet_v2/_C*.so
!wheels/
!wheels/*.whl

# Bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.cache/

# Root CUTLASS auto-clone fallback
/cutlass/

# Local benchmark and NCU profiles (do not publish)
Prompt/
benchmark/
*.ncu-rep
.ipynb_checkpoints/
.vscode/
.idea/

# Keep demo notebook only, ignore other scratch notebooks
*.ipynb
!demo.ipynb
